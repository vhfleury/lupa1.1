# Modo `fornecido` (certificado da CA do orgao ou comprado): arquivos montados em /certs pelo
# docker-compose.prod.yml a partir de LUPA_TLS_CERT e LUPA_TLS_CHAVE (caminhos no host). Renove
# antes do vencimento e rode `docker compose restart proxy`. So TLS 1.3; HSTS ligado.
{$LUPA_DOMINIO} {
	tls /certs/lupa.crt /certs/lupa.key {
		protocols tls1.3
	}
	header Strict-Transport-Security "max-age=31536000; includeSubDomains"
	import lupa_site
}
