# Copie para .env e troque os valores. Todos os valores abaixo sao ficticios.
# Ambiente de execucao: producao, desenvolvimento ou teste.
LUPA_AMBIENTE=desenvolvimento
# Nivel minimo de log: DEBUG, INFO, WARNING ou ERROR.
LUPA_LOG_LEVEL=INFO
# Usuario do PostgreSQL criado na primeira subida.
POSTGRES_USER=lupa
# Senha do PostgreSQL (ficticia; troque no seu .env).
POSTGRES_PASSWORD=troque-esta-senha-ficticia
# Nome do banco do Lupa.
POSTGRES_DB=lupa
# URL do banco para a API fora do compose (no compose ela e montada a partir das variaveis acima).
LUPA_DATABASE_URL=postgresql+psycopg://lupa:troque-esta-senha-ficticia@localhost:5432/lupa
# Endereco host:porta do MinIO fora do compose (no compose e minio:9000).
LUPA_MINIO_ENDPOINT=localhost:9000
# Bucket inicial criado pelo servico minio-init.
LUPA_MINIO_BUCKET=lupa-autos
# Usuario raiz do MinIO e chave de acesso da API (ficticio).
LUPA_MINIO_ACCESS_KEY=lupa-minio-ficticio
# Senha raiz do MinIO e chave secreta da API (ficticia, minimo 8 caracteres).
LUPA_MINIO_SECRET_KEY=troque-este-segredo-ficticio
# Usar HTTPS ao falar com o MinIO (true/false).
LUPA_MINIO_SECURE=false
# Tempo maximo, em segundos, de cada verificacao do GET /saude.
LUPA_TIMEOUT_SAUDE_SEGUNDOS=2
# Porta do host onde a API fica exposta.
API_PORTA_HOST=8000
# Porta do host onde o console do MinIO fica exposto.
MINIO_CONSOLE_PORTA_HOST=9001
# Usuario de conexao da API, sem superusuario e membro de lupa_app (Etapa 3). Crie com
# `docker compose exec api python scripts/criar_usuario_banco.py`. Sem estas duas variaveis a API
# conecta com POSTGRES_USER (dono das tabelas), o que so deve ocorrer em desenvolvimento.
LUPA_DB_USUARIO_APP=lupa_api
LUPA_DB_SENHA_APP=troque-esta-senha-ficticia-da-api
# Caminho (dentro do conteiner) da base GeoLite2-City.mmdb; vazio = localizacao "desconhecida".
# LUPA_GEOIP_CAMINHO=/app/geoip/GeoLite2-City.mmdb
# Usados apenas por scripts/criar_admin.py na primeira instalacao (ficticios).
LUPA_ADMIN_USUARIO=admin
LUPA_ADMIN_SENHA=troque-esta-frase-ficticia-do-admin
# --- Ingestao (Etapa 4A); todos com padrao, descomente para mudar ---
# Implementacao do object storage: s3 (MinIO/AWS) ou memoria (so testes).
# LUPA_STORAGE_BACKEND=s3
# URL do Redis da fila (no compose: redis://redis:6379/0).
# LUPA_REDIS_URL=redis://redis:6379/0
# Tamanho maximo de um upload, em bytes (padrao 512 MB).
# LUPA_UPLOAD_LIMITE_BYTES=536870912
# Limites do sandbox dos parsers: memoria (MB), CPU (s) e tempo de parede (s).
# LUPA_SANDBOX_MEMORIA_MB=1024
# LUPA_SANDBOX_CPU_SEGUNDOS=60
# LUPA_SANDBOX_TEMPO_SEGUNDOS=120
# Limites do inventario de ZIP: entradas, razao de compressao e total descomprimido (bytes).
# LUPA_ZIP_MAX_ENTRADAS=2000
# LUPA_ZIP_MAX_RAZAO=100
# LUPA_ZIP_MAX_DESCOMPRIMIDO_BYTES=4294967296
# Validade do lease do worker (s) e tentativas antes de marcar o job como falho.
# LUPA_LEASE_SEGUNDOS=300
# LUPA_MAX_TENTATIVAS=3
# --- Agente e chat (Etapa 5); todos com padrao, descomente para mudar ---
# Credencial do modelo: NUNCA grave a chave aqui nem em arquivo versionado. No host, o Claude
# Agent SDK usa ANTHROPIC_API_KEY do ambiente ou o login do Claude Code da maquina.
# ANTHROPIC_API_KEY=
# Modelo usado pelo agente (trocar de modelo exige rodar a suite do agente).
# LUPA_MODELO=claude-opus-5-5
# Paginas originais (valvula de escape) por conversa.
# LUPA_AGENTE_MAX_PAGINAS_ORIGINAIS=20
# Tamanho maximo da pergunta, em caracteres.
# LUPA_AGENTE_MAX_CARACTERES_PERGUNTA=2000
# Tetos de tokens (entrada + saida): por chamada, por conversa e por processo.
# LUPA_AGENTE_MAX_TOKENS_CHAMADA=200000
# LUPA_AGENTE_MAX_TOKENS_CONVERSA=1000000
# LUPA_AGENTE_MAX_TOKENS_PROCESSO=5000000
# Turnos do agente por pergunta e pecas resumidas pelo modelo no dossie (?resumos=true).
# LUPA_AGENTE_MAX_TURNOS=12
# LUPA_AGENTE_MAX_RESUMOS_DOSSIE=10
# --- Front e proxy (Etapa 6) ---
# Porta do host do proxy HTTPS (front em / e API em /api): https://localhost:8443
PROXY_PORTA_HOST=8443
# Sub-rede fixa da rede `borda` (proxy, front, api); a API so aceita X-Forwarded-For dela.
# Troque so se colidir com outra rede da maquina.
# REDE_BORDA_SUBREDE=172.31.240.0/24
# API_PORTA_HOST (acima) agora e opcional: a interface usa o proxy. Sem ela, a API fica numa
# porta efemera de 127.0.0.1.
# --- Verificacao (Etapa 6.10) ---
# URL do proxy para a varredura de cabecalhos (verificar.sh usa https://proxy:8443 no conteiner;
# verificar.ps1 usa https://localhost:8443 no host). Com LUPA_EXIGIR_CABECALHOS=1 o passo falha se
# o proxy estiver fora do ar. LUPA_VERIFICAR_E2E=1 faz o verificar.ps1 do host rodar a suite E2E.
# LUPA_PROXY_URL=https://localhost:8443
# LUPA_EXIGIR_CABECALHOS=1
# LUPA_VERIFICAR_E2E=1

# Backup cifrado (Etapa 7.8, ver docs/backup.md). Pastas do HOST montadas no servico `backup`.
# As chaves devem ficar fora do diretorio de backup (de preferencia em outro disco/cofre).
LUPA_BACKUP_DIR=./.backups
LUPA_BACKUP_CHAVES_DIR=./.backup-chaves
LUPA_BACKUP_RETENCAO_DIAS=30
# --- Criptografia em repouso (Etapa 7) ---
# Cofre de chaves: vault (HashiCorp Vault Transit; padrao) ou memoria (so testes, recusado em producao).
LUPA_COFRE_BACKEND=vault
# Endereco do Vault (no compose: http://vault:8200, ja definido no docker-compose.yml).
# LUPA_VAULT_ENDERECO=http://vault:8200
# AppRole da aplicacao: preenchidos por scripts/vault_inicializar.sh (ou .ps1) so no seu .env.
LUPA_VAULT_ROLE_ID=preenchido-pelo-script-vault-inicializar
LUPA_VAULT_SECRET_ID=preenchido-pelo-script-vault-inicializar
# Caminho do Transit engine e tempo maximo de cada chamada ao Vault (s).
# LUPA_VAULT_TRANSIT_MONTAGEM=transit
# LUPA_VAULT_TIMEOUT_SEGUNDOS=5
# Teto de paginas decifradas por busca do agente (o texto cifrado nao aceita ILIKE).
# LUPA_BUSCA_MAX_PAGINAS=5000
# Imagem do object storage (docs/decisoes/object-storage.md); padrao: pgsty/minio por digest.
# STORAGE_IMAGEM=pgsty/minio@sha256:b6bfe7239bfc83fb90d31612d9704d86039dd714f7904b3f1ad68f211e602372
# So para testes (Etapa 7.10): forca a estimativa do backup em bytes, para provar a recusa por falta
# de espaco (tests/backup/test_espaco.py). Nunca defina em uso normal.
# LUPA_BACKUP_ESTIMATIVA_BYTES=
# --- Operacao (Etapa 7.10): ver docs/operacao.md. Em producao deixe API_PORTA_HOST vazio e nao
# publique o console do MinIO; LUPA_VAULT_SECRET_ID e LUPA_ADMIN_SENHA sao segredos. ---
# --- Piloto (Etapa 8.1): ver docs/operacao.md e docker-compose.prod.yml ---
# Certificado do proxy: interno (dev, CA do Caddy), acme (LUPA_DOMINIO + LUPA_ACME_EMAIL) ou
# fornecido (LUPA_TLS_CERT e LUPA_TLS_CHAVE: caminhos no host). O perfil prod usa acme por padrao.
# LUPA_TLS_MODO=interno
# LUPA_DOMINIO=lupa.exemplo
# LUPA_ACME_EMAIL=ti@exemplo.invalid
# LUPA_TLS_CERT=/caminho/lupa.crt
# LUPA_TLS_CHAVE=/caminho/lupa.key
# Pasta dos volumes no perfil prod (de preferencia outro disco), um subdiretorio por volume.
# LUPA_DADOS_DIR=/srv/lupa/dados
# Horarios do backup-agendado (formato cron, fuso UTC do conteiner).
# LUPA_BACKUP_CRON_DIARIO=0 2 * * *
# LUPA_BACKUP_CRON_EXPURGO=30 3 * * 0
# Token do Prometheus para GET /metricas/servico (segredo; gerado pelo instalar_piloto). O mesmo
# valor vai no arquivo LUPA_METRICAS_TOKEN_ARQUIVO (padrao .segredos/metricas_token). Sem ele, a
# rota responde 404.
LUPA_METRICAS_TOKEN=troque-este-token-ficticio-de-metricas
# LUPA_METRICAS_TOKEN_ARQUIVO=./.segredos/metricas_token
# Senha do admin do Grafana fica so em arquivo (padrao .segredos/grafana_senha).
# GRAFANA_SENHA_ARQUIVO=./.segredos/grafana_senha
# PROMETHEUS_PORTA_HOST=9090
# GRAFANA_PORTA_HOST=3000
