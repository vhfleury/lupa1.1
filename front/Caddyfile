# Servidor estatico do front (SPA). Sem TLS: so a rede interna "borda" chega aqui; o TLS fica no proxy.
{
	admin off
	auto_https off
	persist_config off
}

:8080 {
	root * /srv
	encode gzip
	header {
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
		X-Frame-Options DENY
		-Server
	}
	@imutavel path /_app/immutable/*
	header @imutavel Cache-Control "public, max-age=31536000, immutable"
	@html not path /_app/immutable/*
	header @html Cache-Control "no-store"
	try_files {path} /index.html
	file_server
}
